{
  "name": "@wms/domain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pure HVAC warranty rules shared by frontend/ and backend/demo-server/: types, part-wise warranty status, entitlement, registration row checks and claim status steps. No scoping, permissions, seed data or I/O.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.1"
  }
}
