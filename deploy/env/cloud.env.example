# ./run.sh cloud — the same stack on a cloud VM (any Linux host with Docker and Compose v2).
# Copy to deploy/env/cloud.env (git-ignored) and fill in every "change-me". Never commit cloud.env.
#
# Put a load balancer or reverse proxy with TLS in front of WEB_PORT (Azure Application Gateway, AWS ALB, Caddy,
# ...). It must pass X-Forwarded-Proto, so session cookies are marked Secure.

COMPOSE_PROJECT_NAME=hvac-wms
WEB_PORT=80

# Database: either the bundled Postgres container (data in a Docker volume on this VM) ...
USE_BUNDLED_DB=true
DB_OWNER_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# ... or a managed database (Azure Database for PostgreSQL, Amazon RDS): set USE_BUNDLED_DB=false and both URLs.
# The app user needs the wms_app grants from the first migration (create the role before migrating).
# DATABASE_URL=postgresql://wms_app:<password>@<host>:5432/wms_hvac?sslmode=require
# DATABASE_MIGRATION_URL=postgresql://wms_owner:<password>@<host>:5432/wms_hvac?sslmode=require

# Load the starting data on the first start (only into an empty database). false for a real go-live.
SEED_DEMO_DATA=false

# Images: built on the VM by default. To deploy images from a registry instead, push them (see README) and run
# ./run.sh cloud --pull.
IMAGE_REGISTRY=hvac-wms
IMAGE_TAG=local

# Optional: a managed Redis instead of the bundled one.
# REDIS_URL=rediss://:<password>@<host>:6380

# ── API settings (backend/src/config/env.ts) ─────────────────────────────────
NODE_ENV=production
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-me
# Uploads: S3 (or S3-compatible). Production refuses STORAGE_DRIVER=local.
STORAGE_DRIVER=s3
STORAGE_BUCKET=change-me-bucket
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
# STORAGE_ENDPOINT=https://...   # only for S3-compatible services
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
# A cloud demo instead of a go-live: NODE_ENV=staging, DEMO_FEATURES_ENABLED=true, SEED_DEMO_DATA=true
# (staging also allows STORAGE_DRIVER=local).
DEMO_FEATURES_ENABLED=false
SWAGGER_ENABLED=false
LOG_LEVEL=info
