# ./run.sh local — the whole app on this machine. Development values only; safe to commit.
# The same keys as cloud.env.example: only the values differ.

COMPOSE_PROJECT_NAME=hvac-wms
# The app: http://localhost:8088 (8080 is often taken by other tools)
WEB_PORT=8088

# Bundled Postgres (the "db" profile). Passwords are used in connection URLs: letters, digits, - and _ only.
USE_BUNDLED_DB=true
DB_OWNER_PASSWORD=localdev
APP_DB_PASSWORD=localdev
# Load the starting data the first time (only into an empty database).
SEED_DEMO_DATA=true

# Images are built from this checkout.
IMAGE_REGISTRY=hvac-wms
IMAGE_TAG=local

# ── API settings (backend/src/config/env.ts) ─────────────────────────────────
# "staging" allows local file storage and the demo features; "production" refuses both.
NODE_ENV=staging
AUTH_JWT_SECRET=local-only-secret-change-me-0123456789abcdef
STORAGE_DRIVER=local
APP_TIMEZONE=America/Los_Angeles
APP_CURRENCY=USD
# Sign-in account picker and the System events page. Also switches the picker on in the web build.
DEMO_FEATURES_ENABLED=true
DEMO_PASSWORD="Demo#2026"
SWAGGER_ENABLED=false
LOG_LEVEL=info
