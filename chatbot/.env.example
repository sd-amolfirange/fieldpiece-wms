# ── LLM ────────────────────────────────────────────────────────────────────────
# anthropic | openai | ollama | none   ("none" = offline extractive answers, no API key; good for a dry run)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For LLM_PROVIDER=ollama (local models, e.g. LLM_MODEL=llama3.1)
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ─────────────────────────────────────────────────────────────────
# hash   = built-in, offline, no download (lexical-quality vectors; hybrid search keeps results good)
# openai = text-embedding-3-small reduced to 384 dimensions (needs OPENAI_API_KEY)
# ollama = e.g. EMBEDDINGS_MODEL=nomic-embed-text (truncated/padded to 384)
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Knowledge base ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://chatbot:chatbot_local@localhost:5434/chatbot_kb
RETRIEVAL_TOP_K=5
# Chunks scoring below this (after fusion, 0..1) are treated as "not found" -> the bot says it doesn't know.
RETRIEVAL_MIN_SCORE=0.2

# ── WMS integration ────────────────────────────────────────────────────────────
# Base URL of the WMS API. Warranty look-ups forward the signed-in user's own bearer token, so the WMS decides
# what they may see; anonymous visitors get knowledge-base answers only.
WMS_API_URL=http://localhost:8088/api

# ── Server / guardrails ────────────────────────────────────────────────────────
PORT=8090
# Origins allowed to embed the widget (comma-separated).
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
MAX_INPUT_CHARS=1500
RATE_LIMIT_PER_MINUTE=20
