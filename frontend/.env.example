# Copy to .env.local and fill in. Never commit real values (Section 14).
VITE_API_BASE_URL=/api
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_SENTRY_DSN=
# Legacy flag, no longer used: MSW mocks run in unit tests only.
VITE_ENABLE_MOCKS=false
# "true" offers the seed demo accounts on the sign-in page in a build or `npm run dev` (needs ../chatbot running).
VITE_DEMO_MODE=false
# "false" hides the environment tag in the top bar (the demo build does this).
VITE_SHOW_ENV_TAG=true
# "false" hides the "Forgot password" link and shows "Please contact your administrator." on that page (demo build).
VITE_SHOW_FORGOT_PASSWORD=true
# "true" loads the Warranty Assistant chat button in a build or `npm run dev` (needs ../chatbot running).
VITE_ASSISTANT_ENABLED=false
# Where the assistant is served; same origin via the nginx / Vite proxy by default.
VITE_ASSISTANT_URL=/assistant
# Internal Fieldpiece apps in the warranty desk's sidebar (empty = placeholder URL).
VITE_OVERWATCH_URL=
VITE_JOBLINK_URL=
# Legacy screens only. The demo rules use 30 days (src/domain/warranty.ts).
VITE_EXPIRING_SOON_DAYS=30
