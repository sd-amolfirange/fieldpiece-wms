# Copy to .env.local and fill in. Never commit real values (Section 14).
VITE_API_BASE_URL=/api
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_SENTRY_DSN=
# Legacy flag, no longer used: MSW mocks run in unit tests only.
VITE_ENABLE_MOCKS=false
# "true" offers the seed demo accounts on the sign-in page in a production build (always on in `npm run dev`).
VITE_DEMO_MODE=false
# "false" hides the environment tag in the top bar (the demo build does this).
VITE_SHOW_ENV_TAG=true
# Legacy screens only. The demo rules use 30 days (src/domain/warranty.ts).
VITE_EXPIRING_SOON_DAYS=60
