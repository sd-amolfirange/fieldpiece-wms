# Loaded by `npm run build:showcase` (used by `npm run demo` in backend/demo-server/). Safe to commit: no secrets.
VITE_API_BASE_URL=/api
# Offer the demo accounts (fetched from the demo server) on the sign-in page.
VITE_DEMO_MODE=true
# Hide the environment tag in the top bar during the demo.
VITE_SHOW_ENV_TAG=false
# Hide "Forgot password": the demo server has no password reset.
VITE_SHOW_FORGOT_PASSWORD=false
