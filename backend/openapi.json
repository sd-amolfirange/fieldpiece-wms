    "/api/integrations": {
      "get": {
        "operationId": "Integrations_list",
        "summary": "Integration log (A12)",
        "description": "Every message in and out, newest first.",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "PENDING",
                "SUCCESS",
                "FAILED"
              ],
              "type": "string"
            }
          },
          {
            "name": "direction",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "IN",
                "OUT"
              ],
              "type": "string"
            }
          },
          {
            "name": "system",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "CRM",
                "ERP",
                "FINANCE",
                "SERVICE",
                "OEM",
                "EMAIL"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated<IntegrationMessage>"
          }
        },
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/integrations/{id}/retry": {
      "post": {
        "operationId": "Integrations_retry",
        "summary": "Retry a failed message",
        "description": "Sends a FAILED message again (attempts + 1). `409 not_failed` for other messages.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The updated IntegrationMessage"
          }
        },
        "tags": [
          "integrations"
        ]
      }
    },
    "/api/units": {
      "get": {
        "operationId": "Units_list",
        "summary": "Units in the caller's scope",
        "description": "A04, DL04, CU02. `q` matches serial, customer, dealer and model code. Default sort `serial`.",
        "parameters": [
          {
            "name": "dealerId",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "status",
