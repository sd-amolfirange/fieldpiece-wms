{
  "openapi": "3.0.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "operationId": "Health_live",
        "summary": "Liveness",
        "description": "200 if the event loop responds. No dependency checks.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Alive"
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "Health_ready",
        "summary": "Readiness",
        "description": "Checks Postgres (1 s) and Redis. 503 while shutting down.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "Auth_login",
        "summary": "Sign in",
        "description": "Checks email and password. Returns a short-lived access token (send it as `Authorization: Bearer`) and sets the httpOnly `wms_refresh` cookie for POST /auth/refresh.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{ accessToken, user: SessionUser }`"
          },
          "401": {
            "description": "`invalid_credentials`"
          },
          "429": {
            "description": "`rate_limited`"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "Auth_refresh",
        "summary": "New access token from the refresh cookie",
        "description": "Reads `wms_refresh`, extends the session and returns a fresh access token.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "`{ accessToken, user: SessionUser }`"
          },
          "401": {
            "description": "`unauthenticated`: the session ended or expired"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "Auth_logout",
        "summary": "Sign out",
        "description": "Ends the session (refresh cookie and access token).",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/models": {
      "get": {
        "operationId": "Catalog_models",
        "summary": "Fieldpiece product models",
        "description": "A06 and every model picker, with warranty term and serial/batch formats.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ModelView[]"
          }
        },
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/categories": {
      "get": {
        "operationId": "Catalog_categories",
        "summary": "Product categories",
