    "/api/claims": {
      "get": {
        "operationId": "Claims_list",
        "summary": "Warranty claims in the caller's scope",
        "description": "`q` matches claim id, serial, batch, model, customer and dealer. Newest first by default.",
        "parameters": [
          {
            "name": "issueType",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "NO_POWER",
                "INACCURATE_READING",
                "DISPLAY",
                "CONNECTIVITY",
                "LEAK_OR_PRESSURE",
                "MECHANICAL",
                "OTHER"
              ],
              "type": "string"
            }
          },
          {
            "name": "source",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "CUSTOMER",
                "DEALER",
                "ADMIN"
              ],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "SUBMITTED",
                "IN_REVIEW",
                "APPROVED",
                "REJECTED",
                "CLOSED"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated<WarrantyClaimView>"
          }
        },
        "tags": [
          "claims"
        ]
      },
      "post": {
        "operationId": "Claims_create",
        "summary": "File a warranty claim",
        "description": "On a registered product the caller can see. The server records the coverage on the day of filing. `422` validation.issueType / validation.describeFault; `409 not_registered`; `409 claim_open`.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "unitSerial",
                  "issueType",
                  "description"
                ],
                "properties": {
                  "unitSerial": {
                    "type": "string"
                  },
                  "issueType": {
                    "type": "string",
                    "enum": [
                      "NO_POWER",
                      "INACCURATE_READING",
                      "DISPLAY",
                      "CONNECTIVITY",
                      "LEAK_OR_PRESSURE",
                      "MECHANICAL",
                      "OTHER"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 10
                  },
                  "attachmentIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "WarrantyClaimView"
          }
        },
        "tags": [
