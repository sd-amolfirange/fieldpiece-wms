    "/api/units/{serial}/entitlement": {
      "get": {
        "operationId": "Units_entitlement",
        "summary": "What a complaint on this unit would be entitled to today (CU04, DL06)",
        "parameters": [
          {
            "name": "serial",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
