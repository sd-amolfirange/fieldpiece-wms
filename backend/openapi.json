          "catalog"
        ]
      }
    },
    "/api/dealers": {
      "get": {
        "operationId": "Catalog_dealers",
        "summary": "Dealers the caller may see",
        "description": "Admin: all; distributor: its dealers; dealer: itself.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "DealerView[]"
          }
        },
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/admin/org": {
      "get": {
        "operationId": "Catalog_org",
        "summary": "Distributor -> dealer hierarchy and user accounts (A11)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OrgStructure"
          }
        },
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/uploads": {
      "post": {
        "operationId": "Files_upload",
        "summary": "Upload a file",
        "description": "Multipart: `file`, optional `name`. Photos, videos and PDF; 15 MB by default (UPLOAD_MAX_BYTES).",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Attachment"
          },
          "413": {
            "description": "`too_large`"
          },
          "415": {
            "description": "`unsupported_type`"
          }
        },
        "tags": [
          "files"
        ]
      }
    },
    "/api/files/{id}": {
      "get": {
        "operationId": "Files_download",
        "summary": "Download a file",
        "description": "Visible to the uploader, admins and anyone who can see a record that references it. Accepts the bearer token or the session cookie (for <img src> and plain links).",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, `Content-Disposition: inline`"
          }
        },
        "tags": [
          "files"
        ]
      }
    },
    "/api/notifications": {
      "get": {
        "operationId": "Notifications_list",
