      }
    },
    "/api/notifications/read": {
      "post": {
        "operationId": "Notifications_markRead",
        "summary": "Mark notifications read",
        "description": "No ids = all of the caller's notifications.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{ ok: true }`"
          }
        },
        "tags": [
          "notifications"
        ]
      }
