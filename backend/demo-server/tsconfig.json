{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    // src/seed-parity.test.ts type-checks the backend's seed, which imports @wms/domain through backend/tsconfig paths.
    "paths": { "@wms/domain": ["./node_modules/@wms/domain/src/index.ts"] }
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
