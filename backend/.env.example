# Copy to .env for local development. Never commit .env (Section 4).
# Values below target running the API on the host (`pnpm start:dev`) against `docker compose up`.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# 5174 is Vite's fallback port when 5173 is busy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# App connects as the least-privilege role; migrations use the owner role (Section 5.6).
DATABASE_URL=postgresql://wms_app:localdev@localhost:5433/wms
DATABASE_MIGRATION_URL=postgresql://wms_owner:localdev@localhost:5433/wms
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379

# Identity (Section 7.1). In development the built-in dev IdP issues RS256 tokens and serves the JWKS.
# For a real IdP: set these to its values and DEV_IDP_ENABLED=false. [CONFIRM identity provider]
OIDC_ISSUER=http://localhost:3000/dev-idp
OIDC_AUDIENCE=fieldpiece-wms-api
OIDC_JWKS_URI=http://localhost:3000/dev-idp/.well-known/jwks.json
OIDC_ROLES_CLAIM=roles
DEV_IDP_ENABLED=true

# Object storage (ADR-008). MinIO locally.
STORAGE_DRIVER=minio
STORAGE_BUCKET=wms-attachments
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=localdev123
UPLOAD_MAX_BYTES=10485760

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Fieldpiece Warranty <no-reply@fieldpiece.local>"
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

SWAGGER_ENABLED=true
LOG_LEVEL=info

# Business settings [CONFIRM]
EXPIRING_SOON_DAYS=60
SLA_REVIEW_BUSINESS_HOURS=48
BUSINESS_DAY_START_HOUR=8
BUSINESS_DAY_END_HOUR=17
REQUIRE_PROOF_OF_PURCHASE=true
