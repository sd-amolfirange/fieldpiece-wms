# Copy to .env for local development. Never commit .env.
# Values target the API on the host (`npm run start:dev`) with Postgres and Redis from `docker compose up -d`.

NODE_ENV=development
# 4000 is where the frontend's dev server proxies /api (frontend/vite.config.ts), so `npm run dev` there just works.
PORT=4000
API_PREFIX=api
# Only needed when the frontend is served from another origin than the API (no proxy).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The app connects as the least-privilege role; migrations use the owner role (Prisma directUrl).
DATABASE_URL=postgresql://wms_app:localdev@localhost:5433/wms_hvac
DATABASE_MIGRATION_URL=postgresql://wms_owner:localdev@localhost:5433/wms_hvac
DB_POOL_MAX=10

# Optional: shared rate-limit counters. Leave empty for in-process counters.
REDIS_URL=redis://localhost:6379

# Sessions. Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-me-local-development-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=14
AUTH_LOGIN_LIMIT_PER_MINUTE=30

# Uploads. "local" stores files under STORAGE_LOCAL_DIR; use s3 (or minio) anywhere shared.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/storage
# STORAGE_DRIVER=minio
# STORAGE_BUCKET=wms-attachments
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=minio
# STORAGE_SECRET_KEY=localdev123
UPLOAD_MAX_BYTES=15728640
BULK_IMPORT_MAX_BYTES=5242880

# Business calendar and currency [CONFIRM with the business].
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# Demo only: "Sign in as" accounts (GET /auth/demo-accounts) and the A13 simulator. Refused in production.
DEMO_FEATURES_ENABLED=true
DEMO_PASSWORD="Demo#2026"

SWAGGER_ENABLED=true
LOG_LEVEL=info
