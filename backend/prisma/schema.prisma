// Data model for the warranty API. Shapes follow shared/wms-domain (the types the frontend reads) and
// frontend/docs/api-contract.md. Enumerations are text columns with CHECK constraints (see the migrations), so
// the values are exactly the domain's string unions.
// Objects Prisma can't express (CHECK constraints, partial unique indexes, sequences for the "REG-1001" style ids,
// grants) are hand-written in the migration SQL. When `prisma migrate dev` generates a new migration, remove any
// DROP statements it adds for those.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

/// Product category from the Fieldpiece catalogue (Clamp meters, Digital manifolds, ...).
model ProductCategory {
  id       String  @id
  name     String
  /// Display order in lists and charts.
  position Int     @default(0)
  models   Model[]

  @@map("product_categories")
}

/// A Fieldpiece product model (A06), e.g. SC680.
model Model {
  id             String          @id
  /// Model number as printed on the product.
  code           String          @unique
  categoryId     String          @map("category_id")
  name           String
  description    String
  /// Warranty from the date of purchase.
  warrantyMonths Int             @map("warranty_months")
  /// Regular expressions the serial and batch numbers of this model must match. [CONFIRM real label formats]
  serialPattern  String          @map("serial_pattern")
  batchPattern   String          @map("batch_pattern")
  /// Display order in lists and pickers.
  position       Int             @default(0)
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  units          Unit[]

  @@index([categoryId])
  @@map("models")
}

// ── Organisation ─────────────────────────────────────────────────────────────

model Distributor {
  id       String   @id
  name     String
  city     String
  state    String
  position Int      @default(0)
  dealers  Dealer[]
  users    User[]

  @@map("distributors")
}

model Dealer {
  id             String          @id
  name           String
  city           String
  state          String
  distributorId  String?         @map("distributor_id")
  /// Display order (dealer comparison, filters).
  position       Int             @default(0)
  distributor    Distributor?    @relation(fields: [distributorId], references: [id])
  users          User[]
  units          Unit[]
  registrations  Registration[]
  claims         WarrantyClaim[]
  bulkImports    BulkImport[]
  partnerClients PartnerClient[]

  @@index([distributorId])
  @@map("dealers")
}

model Customer {
  id            String          @id
  name          String
  phone         String
  email         String?
  city          String
  /// Two-letter US state code.
  state         String
  zip           String
  /// Last 10 digits of the phone, for matching registrations to an existing customer.
  phoneKey      String?         @map("phone_key")
  /// Lower-cased email, for the same matching.
  emailKey      String?         @map("email_key")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  users         User[]
  units         Unit[]
  registrations Registration[]
  claims        WarrantyClaim[]

  @@index([phoneKey])
  @@index([emailKey])
  @@map("customers")
}

/// A login. Exactly one of dealerId / distributorId / customerId is set for those roles (CHECK in SQL).
model User {
  id            String         @id
  name          String
  /// Stored lower-cased; unique.
  email         String         @unique
  role          String
  dealerId      String?        @map("dealer_id")
  distributorId String?        @map("distributor_id")
  customerId    String?        @map("customer_id")
  /// scrypt hash (see src/modules/auth/password.ts). Null = can't sign in with a password.
  passwordHash  String?        @map("password_hash")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
  dealer        Dealer?        @relation(fields: [dealerId], references: [id])
  distributor   Distributor?   @relation(fields: [distributorId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  sessions      AuthSession[]
  notifications Notification[]

  @@index([role])
  @@map("users")
}

/// A signed-in browser. The refresh cookie carries a random token; only its SHA-256 is stored.
model AuthSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A partner system (distributor ERP, online marketplace, retailer) allowed to send registrations through the partner
/// API. The API key is shown once when created; only its SHA-256 is stored.
model PartnerClient {
  id         String    @id
  name       String
  /// Channel its registrations get: API, RETAIL or ERP.
  channel    String
  /// Dealer the registrations belong to (a distributor's or retailer's own account), if any.
  dealerId   String?   @map("dealer_id")
  keyHash    String    @unique @map("key_hash")
  /// First characters of the key, to recognise it in lists.
  keyPrefix  String    @map("key_prefix")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  dealer     Dealer?   @relation(fields: [dealerId], references: [id])

  @@map("partner_clients")
}

// ── Registered products and warranties ───────────────────────────────────────

/// One physical product. Known before registration (e.g. from an ERP invoice) with no warranty dates; registration
/// sets them. One warranty per product, from the purchase date.
model Unit {
  serial           String          @id
  /// Production lot, printed next to the serial number.
  batchNumber      String?         @map("batch_number")
  modelId          String          @map("model_id")
  dealerId         String?         @map("dealer_id")
  customerId       String?         @map("customer_id")
  purchaseDate     DateTime?       @map("purchase_date") @db.Date
  /// Where it was bought when not from a dealer in the system (online marketplace, retailer).
  placeOfPurchase  String?         @map("place_of_purchase")
  warrantyStart    DateTime?       @map("warranty_start") @db.Date
  warrantyEnd      DateTime?       @map("warranty_end") @db.Date
  registrationId   String?         @map("registration_id")
  replacesSerial   String?         @map("replaces_serial")
  replacedBySerial String?         @map("replaced_by_serial")
  attachmentIds    String[]        @default([]) @map("attachment_ids")
  voidReason       String?         @map("void_reason")
  voidNote         String?         @map("void_note")
  voidedBy         String?         @map("voided_by")
  voidedByName     String?         @map("voided_by_name")
  voidedAt         DateTime?       @map("voided_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  model            Model           @relation(fields: [modelId], references: [id])
  dealer           Dealer?         @relation(fields: [dealerId], references: [id])
  customer         Customer?       @relation(fields: [customerId], references: [id])
  events           UnitEvent[]
  claims           WarrantyClaim[]

  @@index([dealerId])
  @@index([customerId])
  @@index([modelId])
  @@index([warrantyEnd])
  @@index([batchNumber])
  @@index([attachmentIds], map: "units_attachment_ids_idx", type: Gin)
  @@map("units")
}

model UnitEvent {
  id         BigInt   @id @default(autoincrement())
  unitSerial String   @map("unit_serial")
  at         DateTime @db.Timestamptz(3)
  type       String
  byName     String   @map("by_name")
  text       String?
  reason     String?
  refId      String?  @map("ref_id")
  unit       Unit     @relation(fields: [unitSerial], references: [serial], onDelete: Cascade)

  @@index([unitSerial, at])
  @@index([at(sort: Desc)])
  @@map("unit_events")
}

// ── Registrations and bulk import ────────────────────────────────────────────

/// A request to register a product, from any channel. The A02 inbox.
model Registration {
  id                String      @id
  channel           String
  status            String
  flags             String[]    @default([])
  serial            String
  batchNumber       String?     @map("batch_number")
  modelCode         String      @map("model_code")
  customerName      String      @map("customer_name")
  customerPhone     String?     @map("customer_phone")
  customerEmail     String?     @map("customer_email")
  customerCity      String?     @map("customer_city")
  customerState     String?     @map("customer_state")
  customerZip       String?     @map("customer_zip")
  customerId        String?     @map("customer_id")
  dealerId          String?     @map("dealer_id")
  purchaseDate      DateTime?   @map("purchase_date") @db.Date
  invoiceNumber     String?     @map("invoice_number")
  placeOfPurchase   String?     @map("place_of_purchase")
  attachmentIds     String[]    @default([]) @map("attachment_ids")
  /// User id, "system" for ERP / email intake, or "partner:<id>" for the partner API.
  submittedBy       String      @map("submitted_by")
  submittedByName   String      @map("submitted_by_name")
  submittedAt       DateTime    @map("submitted_at") @db.Timestamptz(3)
  duplicateOfSerial String?     @map("duplicate_of_serial")
  rejectReason      String?     @map("reject_reason")
  reviewedByName    String?     @map("reviewed_by_name")
  reviewedAt        DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  importId          String?     @map("import_id")
  customer          Customer?   @relation(fields: [customerId], references: [id])
  dealer            Dealer?     @relation(fields: [dealerId], references: [id])
  bulkImport        BulkImport? @relation(fields: [importId], references: [id])

  @@index([status, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
  @@index([dealerId])
  @@index([customerId])
  @@index([serial])
  @@index([attachmentIds], map: "registrations_attachment_ids_idx", type: Gin)
  @@index([flags], map: "registrations_flags_idx", type: Gin)
  @@map("registrations")
}

model BulkImport {
  id             String          @id
  fileName       String          @map("file_name")
  dealerId       String          @map("dealer_id")
  uploadedBy     String          @map("uploaded_by")
  uploadedByName String          @map("uploaded_by_name")
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(3)
  dealer         Dealer          @relation(fields: [dealerId], references: [id])
  rows           BulkImportRow[]
  registrations  Registration[]

  @@index([dealerId, createdAt(sort: Desc)])
  @@map("bulk_imports")
}

model BulkImportRow {
  importId       String     @map("import_id")
  /// Row number in the uploaded sheet (header = 1).
  rowNumber      Int        @map("row_number")
  /// RegistrationRowInput as read from the sheet (or as fixed inline).
  values         Json
  /// RowErrors: field -> RowErrorCode.
  errors         Json       @default("{}")
  status         String
  registrationId String?    @map("registration_id")
  batch          BulkImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@id([importId, rowNumber])
  @@map("bulk_import_rows")
}

// ── Warranty claims ──────────────────────────────────────────────────────────

/// A warranty claim on a registered product, decided by the Fieldpiece warranty desk.
/// Status steps are defined once, in shared/wms-domain/src/claim-transitions.ts.
model WarrantyClaim {
  id                     String               @id
  unitSerial             String               @map("unit_serial")
  source                 String
  raisedBy               String               @map("raised_by")
  raisedByName           String               @map("raised_by_name")
  dealerId               String?              @map("dealer_id")
  customerId             String?              @map("customer_id")
  issueType              String               @map("issue_type")
  description            String
  attachmentIds          String[]             @default([]) @map("attachment_ids")
  status                 String
  /// Coverage when filed (re-checked if the product is voided later).
  coverage               Json
  resolution             String?
  /// Credit issued, in the account currency.
  creditAmount           Decimal?             @map("credit_amount") @db.Decimal(12, 2)
  replacementSerial      String?              @map("replacement_serial")
  replacementBatchNumber String?              @map("replacement_batch_number")
  decisionNote           String?              @map("decision_note")
  rejectReason           String?              @map("reject_reason")
  reviewedByName         String?              @map("reviewed_by_name")
  createdAt              DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @map("updated_at") @db.Timestamptz(3)
  unit                   Unit                 @relation(fields: [unitSerial], references: [serial])
  dealer                 Dealer?              @relation(fields: [dealerId], references: [id])
  customer               Customer?            @relation(fields: [customerId], references: [id])
  events                 WarrantyClaimEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([dealerId])
  @@index([customerId])
  @@index([unitSerial])
  @@index([attachmentIds], map: "warranty_claims_attachment_ids_idx", type: Gin)
  @@map("warranty_claims")
}

model WarrantyClaimEvent {
  id      BigInt        @id @default(autoincrement())
  claimId String        @map("claim_id")
  at      DateTime      @db.Timestamptz(3)
  status  String
  byName  String        @map("by_name")
  text    String?
  claim   WarrantyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, at])
  @@map("warranty_claim_events")
}

// ── Integrations, notifications, files ───────────────────────────────────────

/// Every message exchanged with ERP, the registration mailbox, partner systems, CRM and Finance (A12).
model IntegrationMessage {
  id        String   @id
  system    String
  direction String
  type      String
  status    String
  payload   Json
  attempts  Int      @default(1)
  lastError String?  @map("last_error")
  refId     String?  @map("ref_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([system, status])
  @@map("integration_messages")
}

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  /// i18n key under `notifications.` in the frontend.
  key       String
  params    Json?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Uploaded file. The bytes live in blob storage under `storageKey`.
model Attachment {
  id         String   @id
  name       String
  mime       String
  size       Int
  storageKey String   @map("storage_key")
  /// User id, or "public" / "partner:<id>" / "system" for files that came in without a login.
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  @@index([uploadedBy])
  @@map("attachments")
}
