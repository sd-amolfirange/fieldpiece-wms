// Data model for the warranty API. Shapes follow shared/wms-domain (the types the frontend reads) and
// frontend/docs/api-contract.md. Enumerations are text columns with CHECK constraints (see the migration), so
// the values are exactly the domain's string unions.
// Objects Prisma can't express (CHECK constraints, partial unique indexes, GIN indexes, sequences for the
// "REG-1001" style ids, grants) are hand-written in the migration SQL. When `prisma migrate dev` generates a new
// migration, remove any DROP statements it adds for those.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ── Catalogue ────────────────────────────────────────────────────────────────

model Brand {
  id       String  @id
  name     String
  /// Display order in lists and charts.
  position Int     @default(0)
  models   Model[]
  units  Unit[]
  claims Claim[]

  @@map("brands")
}

/// Product master: a model and its part template (A06).
model Model {
  id       String      @id
  /// e.g. "AER-SPL15"
  code     String      @unique
  brandId  String      @map("brand_id")
  name     String
  capacity String
  type     String
  /// Display order in lists and pickers.
  position Int         @default(0)
  brand    Brand       @relation(fields: [brandId], references: [id])
  parts    ModelPart[]
  units    Unit[]

  @@index([brandId])
  @@map("models")
}

/// One line of a model template: which part, how long it's covered and what the cover includes.
model ModelPart {
  modelId        String  @map("model_id")
  partType       String  @map("part_type")
  /// Template order (UNIT first).
  position       Int
  warrantyMonths Int     @map("warranty_months")
  coversParts    Boolean @map("covers_parts")
  coversLabour   Boolean @map("covers_labour")
  serialised     Boolean
  model          Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([modelId, partType])
  @@map("model_parts")
}

// ── Organisation ─────────────────────────────────────────────────────────────

model Distributor {
  id       String   @id
  name     String
  city     String
  position Int      @default(0)
  dealers  Dealer[]
  users   User[]

  @@map("distributors")
}

model Dealer {
  id            String         @id
  name          String
  city          String
  distributorId String?        @map("distributor_id")
  /// Display order (dealer comparison, filters).
  position      Int            @default(0)
  distributor   Distributor?   @relation(fields: [distributorId], references: [id])
  users         User[]
  units         Unit[]
  registrations Registration[]
  complaints    Complaint[]
  claims        Claim[]
  bulkImports   BulkImport[]

  @@index([distributorId])
  @@map("dealers")
}

model Customer {
  id            String         @id
  name          String
  phone         String
  email         String?
  city          String
  /// Last 10 digits of the phone, for matching registrations to an existing customer.
  phoneKey      String?        @map("phone_key")
  /// Lower-cased email, for the same matching.
  emailKey      String?        @map("email_key")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  users         User[]
  units         Unit[]
  registrations Registration[]
  complaints    Complaint[]

  @@index([phoneKey])
  @@index([emailKey])
  @@map("customers")
}

/// A login. Exactly one of dealerId / distributorId / customerId is set for those roles (CHECK in SQL).
model User {
  id            String         @id
  name          String
  /// Stored lower-cased; unique.
  email         String         @unique
  role          String
  dealerId      String?        @map("dealer_id")
  distributorId String?        @map("distributor_id")
  customerId    String?        @map("customer_id")
  /// scrypt hash (see src/modules/auth/password.ts). Null = can't sign in with a password.
  passwordHash  String?        @map("password_hash")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(3)
  dealer        Dealer?        @relation(fields: [dealerId], references: [id])
  distributor   Distributor?   @relation(fields: [distributorId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  sessions      AuthSession[]
  notifications Notification[]

  @@index([role])
  @@map("users")
}

/// A signed-in browser. The refresh cookie carries a random token; only its SHA-256 is stored.
model AuthSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ── Units and warranties ─────────────────────────────────────────────────────

/// A physical unit. Known before registration (QR label printed) with no parts; registration attaches the parts.
model Unit {
  serial         String       @id
  modelId        String       @map("model_id")
  brandId        String       @map("brand_id")
  dealerId       String?      @map("dealer_id")
  customerId     String?      @map("customer_id")
  location       String?
  installDate    DateTime?    @map("install_date") @db.Date
  purchaseDate   DateTime?    @map("purchase_date") @db.Date
  registrationId String?      @map("registration_id")
  attachmentIds  String[]     @default([]) @map("attachment_ids")
  voidReason     String?      @map("void_reason")
  voidNote       String?      @map("void_note")
  voidedBy       String?      @map("voided_by")
  voidedByName   String?      @map("voided_by_name")
  voidedAt       DateTime?    @map("voided_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  model          Model        @relation(fields: [modelId], references: [id])
  brand          Brand        @relation(fields: [brandId], references: [id])
  dealer         Dealer?      @relation(fields: [dealerId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  parts          UnitPart[]
  events         UnitEvent[]
  complaints     Complaint[]
  claims         Claim[]

  @@index([dealerId])
  @@index([customerId])
  @@index([modelId])
  @@index([attachmentIds], map: "units_attachment_ids_idx", type: Gin)
  @@map("units")
}

/// One part's warranty. A replaced part stays as history (replacedAt set) next to its replacement.
model UnitPart {
  id               String    @id
  unitSerial       String    @map("unit_serial")
  position         Int
  partType         String    @map("part_type")
  serial           String?
  warrantyStart    DateTime  @map("warranty_start") @db.Date
  warrantyEnd      DateTime  @map("warranty_end") @db.Date
  coversParts      Boolean   @map("covers_parts")
  coversLabour     Boolean   @map("covers_labour")
  replacedAt       DateTime? @map("replaced_at") @db.Date
  replacedBySerial String?   @map("replaced_by_serial")
  replacesSerial   String?   @map("replaces_serial")
  unit             Unit      @relation(fields: [unitSerial], references: [serial], onDelete: Cascade)

  @@index([unitSerial])
  @@map("unit_parts")
}

model UnitEvent {
  id         BigInt   @id @default(autoincrement())
  unitSerial String   @map("unit_serial")
  at         DateTime @db.Timestamptz(3)
  type       String
  byName     String   @map("by_name")
  text       String?
  reason     String?
  refId      String?  @map("ref_id")
  unit       Unit     @relation(fields: [unitSerial], references: [serial], onDelete: Cascade)

  @@index([unitSerial, at])
  @@index([at(sort: Desc)])
  @@map("unit_events")
}

// ── Registrations and bulk import ────────────────────────────────────────────

/// A request to register a unit, from any channel. The A02 inbox.
model Registration {
  id                String      @id
  channel           String
  status            String
  flags             String[]    @default([])
  serial            String
  modelCode         String      @map("model_code")
  customerName      String      @map("customer_name")
  customerPhone     String?     @map("customer_phone")
  customerEmail     String?     @map("customer_email")
  customerCity      String?     @map("customer_city")
  customerId        String?     @map("customer_id")
  dealerId          String?     @map("dealer_id")
  installDate       DateTime?   @map("install_date") @db.Date
  purchaseDate      DateTime?   @map("purchase_date") @db.Date
  invoiceNumber     String?     @map("invoice_number")
  location          String?
  attachmentIds     String[]    @default([]) @map("attachment_ids")
  /// User id, or "system" for ERP / email intake.
  submittedBy       String      @map("submitted_by")
  submittedByName   String      @map("submitted_by_name")
  submittedAt       DateTime    @map("submitted_at") @db.Timestamptz(3)
  duplicateOfSerial String?     @map("duplicate_of_serial")
  rejectReason      String?     @map("reject_reason")
  reviewedByName    String?     @map("reviewed_by_name")
  reviewedAt        DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  batchId           String?     @map("batch_id")
  customer          Customer?   @relation(fields: [customerId], references: [id])
  dealer            Dealer?     @relation(fields: [dealerId], references: [id])
  batch             BulkImport? @relation(fields: [batchId], references: [id])

  @@index([status, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
  @@index([dealerId])
  @@index([customerId])
  @@index([serial])
  @@index([attachmentIds], map: "registrations_attachment_ids_idx", type: Gin)
  @@index([flags], map: "registrations_flags_idx", type: Gin)
  @@map("registrations")
}

model BulkImport {
  id             String          @id
  fileName       String          @map("file_name")
  dealerId       String          @map("dealer_id")
  uploadedBy     String          @map("uploaded_by")
  uploadedByName String          @map("uploaded_by_name")
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(3)
  dealer         Dealer          @relation(fields: [dealerId], references: [id])
  rows           BulkImportRow[]
  registrations  Registration[]

  @@index([dealerId, createdAt(sort: Desc)])
  @@map("bulk_imports")
}

model BulkImportRow {
  importId       String     @map("import_id")
  /// Row number in the uploaded sheet (header = 1).
  rowNumber      Int        @map("row_number")
  /// RegistrationRowInput as read from the sheet (or as fixed inline).
  values         Json
  /// RowErrors: field -> RowErrorCode.
  errors         Json       @default("{}")
  status         String
  registrationId String?    @map("registration_id")
  batch          BulkImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@id([importId, rowNumber])
  @@map("bulk_import_rows")
}

// ── Complaints, service jobs and claims ──────────────────────────────────────

model Complaint {
  id               String           @id
  unitSerial       String           @map("unit_serial")
  source           String
  raisedBy         String           @map("raised_by")
  raisedByName     String           @map("raised_by_name")
  dealerId         String?          @map("dealer_id")
  customerId       String?          @map("customer_id")
  description      String
  attachmentIds    String[]         @default([]) @map("attachment_ids")
  status           String
  /// Entitlement decided when the complaint was raised (re-checked if the unit is voided later).
  entitlement      Json
  serviceRequestId String?          @map("service_request_id")
  jobResultId      String?          @map("job_result_id")
  claimId          String?          @map("claim_id")
  createdAt        DateTime         @map("created_at") @db.Timestamptz(3)
  unit             Unit             @relation(fields: [unitSerial], references: [serial])
  dealer           Dealer?          @relation(fields: [dealerId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  events           ComplaintEvent[]
  jobResult        JobResult?

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([dealerId])
  @@index([customerId])
  @@index([unitSerial])
  @@index([attachmentIds], map: "complaints_attachment_ids_idx", type: Gin)
  @@map("complaints")
}

model ComplaintEvent {
  id          BigInt    @id @default(autoincrement())
  complaintId String    @map("complaint_id")
  at          DateTime  @db.Timestamptz(3)
  status      String
  byName      String    @map("by_name")
  text        String?
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, at])
  @@map("complaint_events")
}

/// The service system's report of a completed visit.
model JobResult {
  id            String    @id
  complaintId   String    @unique @map("complaint_id")
  technician    String
  completedAt   DateTime  @map("completed_at") @db.Timestamptz(3)
  /// ReplacedPart[]
  partsReplaced Json      @map("parts_replaced")
  photoIds      String[]  @default([]) @map("photo_ids")
  signOffName   String    @map("sign_off_name")
  notes         String?
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([photoIds], map: "job_results_photo_ids_idx", type: Gin)
  @@map("job_results")
}

/// Manufacturer claim. Status steps are defined once, in shared/wms-domain/src/claim-transitions.ts.
model Claim {
  id             String       @id
  complaintId    String?      @map("complaint_id")
  unitSerial     String       @map("unit_serial")
  brandId        String       @map("brand_id")
  dealerId       String?      @map("dealer_id")
  status         String
  rmaNumber      String?      @map("rma_number")
  /// Whole units of the account currency.
  amount         Int?
  jobResultId    String?      @map("job_result_id")
  photoIds       String[]     @default([]) @map("photo_ids")
  /// ReplacedPart[]
  partsReplaced  Json         @map("parts_replaced")
  financePosting String       @map("finance_posting")
  rejectReason   String?      @map("reject_reason")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  unit           Unit         @relation(fields: [unitSerial], references: [serial])
  brand          Brand        @relation(fields: [brandId], references: [id])
  dealer         Dealer?      @relation(fields: [dealerId], references: [id])
  events         ClaimEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([brandId])
  @@index([dealerId])
  @@map("claims")
}

model ClaimEvent {
  id      BigInt   @id @default(autoincrement())
  claimId String   @map("claim_id")
  at      DateTime @db.Timestamptz(3)
  status  String
  byName  String   @map("by_name")
  text    String?
  claim   Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, at])
  @@map("claim_events")
}

// ── Integrations, notifications, files ───────────────────────────────────────

/// Every message exchanged with CRM, ERP, Finance, the service system, the OEM and the mailbox (A12).
model IntegrationMessage {
  id        String   @id
  system    String
  direction String
  type      String
  status    String
  payload   Json
  attempts  Int      @default(1)
  lastError String?  @map("last_error")
  refId     String?  @map("ref_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([system, status])
  @@map("integration_messages")
}

model Notification {
  id        String   @id
  userId    String   @map("user_id")
  /// i18n key under `notifications.` in the frontend.
  key       String
  params    Json?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Uploaded file. The bytes live in blob storage under `storageKey`.
model Attachment {
  id         String   @id
  name       String
  mime       String
  size       Int
  storageKey String   @map("storage_key")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  @@index([uploadedBy])
  @@map("attachments")
}
